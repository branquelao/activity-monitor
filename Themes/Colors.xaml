<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-based resources -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Light theme colors -->
        <ResourceDictionary x:Key="Light">
            <!-- App base colors -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#1F1F1F"/>

            <!-- Header buttons -->
            <SolidColorBrush x:Key="HeaderButtonForeground" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="HeaderButtonBorder" Color="#C7C7C7"/>
            <SolidColorBrush x:Key="HeaderButtonActiveBackground" Color="#E5E5E5"/>

            <!-- Performance indicators -->
            <SolidColorBrush x:Key="UsedBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="FreeBrush" Color="#0F7B0F"/>

            <!-- Delete button -->
            <SolidColorBrush x:Key="DeleteButtonBackground" Color="#C42B1C"/>
            <SolidColorBrush x:Key="DeleteButtonPointerOver" Color="#B3261E"/>
            <SolidColorBrush x:Key="DeleteButtonPressed" Color="#8B1D18"/>
            <SolidColorBrush x:Key="DeleteButtonForeground" Color="#FFFFFF"/>

        </ResourceDictionary>

        <!-- Dark theme colors -->
        <ResourceDictionary x:Key="Dark">
            <!-- App base colors -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000"/>
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFFFFF"/>

            <!-- Header buttons -->
            <SolidColorBrush x:Key="HeaderButtonForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HeaderButtonBorder" Color="#6F6F6F"/>
            <SolidColorBrush x:Key="HeaderButtonActiveBackground" Color="#3A3A3A"/>

            <!-- Performance indicators -->
            <SolidColorBrush x:Key="UsedBrush" Color="#FF6A5E"/>
            <SolidColorBrush x:Key="FreeBrush" Color="#5EDB8C"/>

            <!-- Delete button -->
            <SolidColorBrush x:Key="DeleteButtonBackground" Color="#FF6A5E"/>
            <SolidColorBrush x:Key="DeleteButtonPointerOver" Color="#E05A50"/>
            <SolidColorBrush x:Key="DeleteButtonPressed" Color="#B7443C"/>
            <SolidColorBrush x:Key="DeleteButtonForeground" Color="#FFFFFF"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
