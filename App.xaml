<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ActivityMonitor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ActivityMonitor.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Colors.xaml"/>
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <!-- Normal Button Style -->
            <Style x:Key="HeaderButtonInactive"
                   TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource HeaderButtonForeground}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource HeaderButtonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Active Button Style -->
            <Style x:Key="HeaderButtonActive"
                   TargetType="Button"
                   BasedOn="{StaticResource HeaderButtonInactive}">
                <Setter Property="Background"
                        Value="{ThemeResource HeaderButtonActiveBackground}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{ThemeResource AppForegroundBrush}" />
            </Style>

            <!-- Delete Button Style -->
            <Style x:Key="DeleteButtonStyle"
                   TargetType="Button">

                <Setter Property="Background"
                        Value="{ThemeResource DeleteButtonBackground}"/>
                <Setter Property="Foreground"
                        Value="{ThemeResource DeleteButtonForeground}"/>
                <Setter Property="BorderBrush"
                        Value="Transparent"/>
                <Setter Property="CornerRadius"
                        Value="6"/>
                <Setter Property="FontWeight"
                        Value="Bold"/>
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="32"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal"/>

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootBorder"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame
                                                        Value="{ThemeResource DeleteButtonPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootBorder"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame
                                                        Value="{ThemeResource DeleteButtonPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="RootBorder"
                                                Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame Value="0.5" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="RootBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}"/>
                                </Border>

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid Column Header Arrows -->
            <DataTemplate x:Key="SortableHeaderTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="SortArrow"
                               Grid.Column="1"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </DataTemplate>

            <!-- Converter -->
            <local:ButtonConverter
            x:Key="HeaderButtonStyleConverter"
            ActiveStyle="{StaticResource HeaderButtonActive}"
            InactiveStyle="{StaticResource HeaderButtonInactive}" />

            <!--Right Aligned Cell Style -->
            <Style x:Key="RightAlignedCell"
                   TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>

            <!-- DataGrid Cell Style - Remove focus border completamente -->
            <Style TargetType="controls:DataGridCell">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:DataGridCell">
                            <Grid Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}">

                                <ContentPresenter 
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Selected Row Color -->
            <SolidColorBrush x:Key="DataGridRowSelectedBackground"
                 Color="#0076D7"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
