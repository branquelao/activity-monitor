<Window
    x:Class="ActivityMonitor.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:localControls="using:ActivityMonitor.Controls"
    xmlns:converters="using:ActivityMonitor.Converters"
    Title="Activity Monitor">
    
    <!-- Root layout container -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}">

        <!-- Header / Content / Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shared converters -->
        <Grid.Resources>
            <converters:TimeSpanConverter x:Key="TimeSpanConverter"/>
        </Grid.Resources>

        <!-- Top action bar -->
        <Grid Grid.Row="0"
              Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Centered action buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">

                <Button x:Name="EndButton"
                        Content="X"
                        Style="{StaticResource DeleteButtonStyle}"
                        Command="{Binding EndTaskCommand}"/>

                <Button x:Name="CpuButton"
                        Style="{Binding IsCpuMode, Converter={StaticResource HeaderButtonStyleConverter}}"
                        Content="CPU"
                        Command="{Binding CpuCommand}"/>
                
                <Button x:Name="MemoryButton"
                        Style="{Binding IsMemoryMode, Converter={StaticResource HeaderButtonStyleConverter}}"
                        Content="Memory"
                        Command="{Binding MemoryCommand}"/>
            </StackPanel>

            <!-- Search bar -->
            <AutoSuggestBox
                Grid.Column="2"
                Width="220"
                PlaceholderText="Search process..."
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                HorizontalAlignment="Right"/>
        </Grid>

        <!-- Process list -->
        <controls:DataGrid x:Name="ProcessGrid"
                           Grid.Row="1"
                           ItemsSource="{Binding FilteredProcesses}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           HeadersVisibility="Column"
                           SelectionMode="Single"
                           CanUserSortColumns="True"
                           Sorting="ProcessSorting"
                           SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
            
            <!-- Process Name Column -->
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn
                    x:Name="ProcessColumn"
                    Header="Process"
                    Width="*">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0">
                                <!-- Process Icon or Standard Icon -->
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <!-- Real Process Icon (If Available) -->
                                    <Image Source="{Binding Icon}"
                                           Width="16"
                                           Height="16"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <!-- Standard Icon (If Icon is Null) -->
                                    <FontIcon Glyph="&#xE756;"
                                              FontSize="14"
                                              Visibility="{Binding Icon, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Process Name -->
                                <TextBlock Text="{Binding Name}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <!-- CPU Mode Columns -->
                <controls:DataGridTextColumn
                    x:Name="CpuColumn"
                    Header="CPU (%)"
                    Binding="{Binding CpuDisplay}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}" >
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="CPU Time"
                    Binding="{Binding CpuTime, Converter={StaticResource TimeSpanConverter}}"
                    Width="140"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}">
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="Threads"
                    Binding="{Binding ThreadCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}">
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="Type"
                    Binding="{Binding ExecutionType}"
                    Width="140"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}">
                </controls:DataGridTextColumn>

                <!-- Memory Mode Columns -->
                <controls:DataGridTextColumn
                    x:Name="MemoryColumn"
                    Header="Memory (MB)"
                    Binding="{Binding MemoryDisplay}"
                    Width="140"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="Threads"
                    Binding="{Binding ThreadCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="Handles"
                    Binding="{Binding HandleCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">
                    <controls:DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </controls:DataGridTextColumn.ElementStyle>
                </controls:DataGridTextColumn>

                <controls:DataGridTextColumn
                    Header="Type"
                    Binding="{Binding ExecutionType}"
                    Width="140"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">
                </controls:DataGridTextColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- CPU summary and graph -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,8,0,12"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}">

            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center">

                <TextBlock FontSize="14">
                    <Run Text="CPU Used: "/>
                    <Run Text="{x:Bind ViewModel.CpuUsedText, Mode=OneWay}"
                         Foreground="{ThemeResource UsedBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock FontSize="14">
                    <Run Text="CPU Free: "/>
                    <Run Text="{x:Bind ViewModel.CpuFreeText, Mode=OneWay}"
                         Foreground="{ThemeResource FreeBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>

            </StackPanel>

            <localControls:PerformanceGraph
                Height="120"
                Width="450"
                Margin="0,6,0,0"
                Values="{Binding CpuHistory}"
                MaxValue="100"/>
        </StackPanel>

        <!-- Memory summary and graph -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,8,0,12"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">

            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center">

                <TextBlock FontSize="14">
                        <Run Text="Memory Used: "/>
                        <Run Text="{x:Bind ViewModel.MemoryUsedText, Mode=OneWay}"
                             Foreground="{ThemeResource UsedBrush}"
                             FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock FontSize="14">
                    <Run Text="Total Memory: "/>
                    <Run Text="{x:Bind ViewModel.MemoryTotalText, Mode=OneWay}"
                         Foreground="{ThemeResource FreeBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>

            </StackPanel>

            <localControls:PerformanceGraph
                Height="120"
                Width="450"
                Margin="0,6,0,0"
                Values="{Binding MemoryHistory}"
                MaxValue="100"/>
        </StackPanel>

    </Grid>
</Window>
