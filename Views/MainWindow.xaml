<Window
    x:Class="ActivityMonitor.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:localControls="using:ActivityMonitor.Controls"
    xmlns:converters="using:ActivityMonitor.Converters"
    Title="Activity Monitor">

    <!-- Root layout container -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}">

        <!-- Header / Content / Footer -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shared converters -->
        <Grid.Resources>
            <converters:TimeSpanConverter x:Key="TimeSpanConverter"/>
        </Grid.Resources>

        <!-- Top action bar -->
        <Grid Grid.Row="0"
              Padding="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Centered action buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">

                <Button x:Name="EndButton"
                        Content="X"
                        Background="Red"
                        Command="{Binding EndTaskCommand}"/>

                <Button x:Name="CpuButton"
                        Style="{Binding IsCpuMode, Converter={StaticResource HeaderButtonStyleConverter}}"
                        Content="CPU"
                        Command="{Binding CpuCommand}"/>

                <Button x:Name="MemoryButton"
                        Style="{Binding IsMemoryMode, Converter={StaticResource HeaderButtonStyleConverter}}"
                        Content="Memory"
                        Command="{Binding MemoryCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Process list -->
        <controls:DataGrid x:Name="ProcessGrid"
                           Grid.Row="1"
                           ItemsSource="{Binding Processes}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           HeadersVisibility="Column"
                           SelectionMode="Single"
                           CanUserSortColumns="True"
                           Sorting="ProcessSorting"
                           SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">

            <controls:DataGrid.Columns>

                <controls:DataGridTextColumn
                    Header="Process"
                    Binding="{Binding Name}"
                    Width="*"/>

                <!-- CPU mode columns -->
                <controls:DataGridTextColumn
                    Header="CPU (%)"
                    Binding="{Binding Cpu}"
                    Width="120"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}"/>

                <controls:DataGridTextColumn
                    Header="CPU Time"
                    Binding="{Binding CpuTime, Converter={StaticResource TimeSpanConverter}}"
                    Width="140"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="Threads"
                    Binding="{Binding ThreadCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="PID"
                    Binding="{Binding Id}"
                    Width="90"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="Type"
                    Binding="{Binding OwnerType}"
                    Width="120"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}" />

                <!-- Memory mode columns -->
                <controls:DataGridTextColumn
                    Header="Memory (MB)"
                    Binding="{Binding Memory}"
                    Width="150"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}"/>

                <controls:DataGridTextColumn
                    Header="Threads"
                    Binding="{Binding ThreadCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="Handles"
                    Binding="{Binding HandleCount}"
                    Width="100"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="PID"
                    Binding="{Binding Id}"
                    Width="90"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}" />

                <controls:DataGridTextColumn
                    Header="Type"
                    Binding="{Binding OwnerType}"
                    Width="120"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- CPU summary and graph -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,8,0,12"
                    Visibility="{x:Bind ViewModel.IsCpuMode, Mode=OneWay}">

            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center">

                <TextBlock FontSize="14">
                    <Run Text="CPU Used: "/>
                    <Run Text="{x:Bind ViewModel.CpuUsedText}"
                         Foreground="{ThemeResource UsedBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock FontSize="14">
                    <Run Text="CPU Free: "/>
                    <Run Text="{x:Bind ViewModel.CpuFreeText}"
                         Foreground="{ThemeResource FreeBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <localControls:PerformanceGraph
                Height="120"
                Width="450"
                Values="{Binding CpuHistory}"
                MaxValue="100"/>
        </StackPanel>

        <!-- Memory summary and graph -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,8,0,12"
                    Visibility="{x:Bind ViewModel.IsMemoryMode, Mode=OneWay}">

            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center">

                <TextBlock FontSize="14">
                    <Run Text="Memory Used: "/>
                    <Run Text="{x:Bind ViewModel.MemoryUsedText}"
                         Foreground="{ThemeResource UsedBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>

                <TextBlock FontSize="14">
                    <Run Text="Total Memory: "/>
                    <Run Text="{x:Bind ViewModel.MemoryTotalText}"
                         Foreground="{ThemeResource FreeBrush}"
                         FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <localControls:PerformanceGraph
                Height="120"
                Width="450"
                Values="{Binding MemoryHistory}"
                MaxValue="100"/>
        </StackPanel>

    </Grid>
</Window>
